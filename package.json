{
  "name": "spaced-learning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply spaced-learning --local",
    "db:migrate:remote": "wrangler d1 migrations apply spaced-learning --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "jose": "6.2.15",
    "katex": "0.19.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "tailwind-merge": "3.7.0",
    "ts-fsrs": "5.4.2",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.5",
    "@cloudflare/vite-plugin": "1.67.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "fake-indexeddb": "6.2.7",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
