{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/worker-configuration.d.ts", "!**/src/content/decks/*.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "dexie": "Only src/db and src/sync touch Dexie; read through db/queries.ts or db/hooks.ts and write through Repo (see CLAUDE.md).",
              "dexie-react-hooks": "Use the hooks in src/db/hooks.ts.",
              "ts-fsrs": "Only src/domain/scheduler.ts talks to ts-fsrs."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/db/**", "src/sync/**", "src/domain/scheduler.ts", "**/*.test.*"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
