{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spaced-learning",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    // Serves the Vite build; unknown paths fall back to index.html (client-side routing).
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker; everything else is a static asset.
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spaced-learning",
      // Replace with the id printed by `npx wrangler d1 create spaced-learning` (see README).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Non-secret configuration. ACCESS_TEAM_DOMAIN, ACCESS_AUD and ALLOWED_EMAIL are set as
  // secrets (`npx wrangler secret put …`) so they never live in the repository.
  "vars": {},
  "observability": { "enabled": true }
}
