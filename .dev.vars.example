# Copy to .dev.vars for local development (`npm run dev`). Never deploy these values.
# The bypass only works for requests to localhost / 127.0.0.1 (see worker/access.ts).
DEV_AUTH_BYPASS=1
DEV_USER_EMAIL=dev@localhost

# Production values are set with `npx wrangler secret put <NAME>`:
#   ACCESS_TEAM_DOMAIN  e.g. https://your-team.cloudflareaccess.com
#   ACCESS_AUD          the Application Audience (AUD) tag of the Access application
#   ALLOWED_EMAIL       exactly one email address (a comma-separated list is rejected)
